{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LoL Overlay",
  "version": "0.1.0",
  "identifier": "dev.loloverlay.app",
  "build": {
    "frontendDist": "../../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": { "script": "npm run dev", "cwd": "../../ui", "wait": false },
    "beforeBuildCommand": { "script": "npm run build", "cwd": "../../ui" }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LoL Overlay",
        "width": 980,
        "height": 680,
        "minWidth": 760,
        "minHeight": 520,
        "visible": false,
        "zoomHotkeysEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' https://ddragon.leagueoflegends.com https://raw.communitydragon.org data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico", "icons/icon.png"],
    "resources": ["resources/*"],
    "category": "Utility",
    "shortDescription": "League of Legends companion",
    "copyright": "LoL Overlay is not endorsed by Riot Games and does not reflect the views or opinions of Riot Games or anyone officially involved in producing or managing Riot Games properties."
  }
}
